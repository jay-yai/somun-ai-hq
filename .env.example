# ============================================================
# SOMUN AI HQ - 환경변수 예시 파일
# 실제 값은 .env.local 파일에 넣으세요 (git에 절대 올리지 않습니다)
# ============================================================

# --- Database (Supabase Postgres) ---
# Supabase Project Settings > Database > Connection string 에서 복사
# Transaction pooler (포트 6543, 앱 런타임용, 서버리스에 적합)
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (포트 5432, 마이그레이션 전용)
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-xxxx.pooler.supabase.com:5432/postgres"

# --- 로그인 (Google OAuth) ---
AUTH_SECRET="" # npx auth secret 명령으로 생성
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# 로그인을 허용할 이메일 목록 (쉼표로 구분, 공백 없이)
ALLOWED_EMAILS="dopes793@gmail.com"

# --- AI Provider API Keys (서버에서만 사용, 브라우저 노출 없음) ---
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# --- Agent별 사용 모델 (코드에 하드코딩하지 않고 여기서 관리) ---
# 업무 난이도별로 다른 모델을 쓸 수 있도록 팀별 기본/고성능 모델을 분리한다.
# Orchestrator는 라우팅 판단만 하므로 저비용 모델을 사용한다.
ORCHESTRATOR_MODEL_DEFAULT="gpt-5-mini"
STRATEGY_MODEL_DEFAULT="gpt-5-mini"
STRATEGY_MODEL_HIGH="gpt-5"
PRODUCT_MODEL_DEFAULT="claude-sonnet-5"
PRODUCT_MODEL_HIGH="claude-opus-5"
GROWTH_MODEL_DEFAULT="gemini-3.5-flash"
GROWTH_MODEL_HIGH="gemini-3.1-pro"
CS_MODEL_DEFAULT="gpt-5-mini"
CS_MODEL_HIGH="gpt-5-mini"

# --- Google Drive 연동 ---
# Google Cloud Console에서 발급받은 OAuth 클라이언트 (로그인용과 동일 계정 사용 가능)
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
# 최초 1회 인증 후 발급되는 Refresh Token (재인증 없이 계속 사용)
GOOGLE_DRIVE_REFRESH_TOKEN=""
# 회사 자료가 들어있는 Google Drive 최상위 폴더 ID
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# --- 네이버 블로그 연동 (Growth팀 글 자동 게시) ---
# 네이버 개발자센터(developers.naver.com)에서 앱 등록 + "블로그" API 사용 설정 필요
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
# 최초 1회 인증 후 발급되는 Refresh Token
NAVER_REFRESH_TOKEN=""

# --- App ---
NEXTAUTH_URL="http://localhost:3000"
